<%- include('../partials/header') %>
<h1>Pets</h1>
<p><a href="/pets/novo">Novo pet</a></p>
<table>
  <tr><th>Nome</th><th>Espécie</th><th>Raça</th><th>Tutor</th><th>Nascimento</th><th>Ações</th></tr>
  <% if (!pets.length) { %><tr><td colspan="6">Nenhum pet cadastrado.</td></tr><% } %>
  <% pets.forEach((pet) => { %>
  <tr>
    <td><%= pet.nome %></td>
    <td><%= pet.especie %></td>
    <td><%= pet.raca || '' %></td>
    <td><%= pet.tutor_nome %></td>
    <td><%= pet.data_nascimento ? String(pet.data_nascimento).slice(0, 10).split('-').reverse().join('/') : '' %></td>
    <td>
      <a href="/pets/<%= pet.id %>/editar">Editar</a>
      <form action="/pets/<%= pet.id %>/excluir" method="post" onsubmit="return confirm('Excluir este pet?')"><button type="submit">Excluir</button></form>
    </td>
  </tr>
  <% }) %>
</table>
<%- include('../partials/footer') %>
