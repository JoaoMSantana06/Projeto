<%- include('../partials/header') %>
<h1><%= titulo %></h1>
<% if (erro) { %><p class="aviso erro"><%= erro %></p><% } %>
<form action="<%= acao %>" method="post" class="form">
  <label for="nome">Nome</label>
  <input id="nome" name="nome" required maxlength="120" value="<%= tutor.nome || '' %>">
  <label for="cpf">CPF</label>
  <input id="cpf" name="cpf" inputmode="numeric" autocomplete="off" <%= tutor.id ? '' : 'required' %> value="">
  <label for="email">E-mail</label>
  <input id="email" name="email" type="email" maxlength="160" value="<%= tutor.email || '' %>">
  <label for="telefone">Telefone</label>
  <input id="telefone" name="telefone" maxlength="30" value="<%= tutor.telefone || '' %>">
  <p>
    <button type="submit">Salvar</button>
    <a href="/tutores">Cancelar</a>
  </p>
</form>
<%- include('../partials/footer') %>
